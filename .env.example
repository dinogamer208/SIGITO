# Copia este archivo a `.env` y rellena tus valores locales:  cp .env.example .env
# El `.env` NO se sube al repo (ver .gitignore).

SIGITO_DB_HOST=localhost
SIGITO_DB_PORT=3306
SIGITO_DB_USER=root
SIGITO_DB_PASSWORD=
SIGITO_DB_NAME=sigito_db

# SMTP (opcional, para reportes por correo)
SIGITO_SMTP_USER=
SIGITO_SMTP_APP_PASSWORD=
